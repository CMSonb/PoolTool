        "dcType": [
          {
            "@value": "letter",
            "@language": "en"
          },
          {
            "@value": "Brief",
            "@language": "de"
          },
          {
            "id": "http://vocab.getty.edu/aat/300026879",
            "note": [
              {
                "@value": "Pieces of correspondence that are somewhat more formal than memoranda or notes, usually on paper and delivered.",
                "@language": "en"
              },
              {
                "@value": "Úsese para correspondencia que son algo más formales que la memoranda o notas, generalmente en papel y para ser entregadas a un destinatario.",
                "@language": "es"
              },
              {
                "@value": "Wordt gebruikt voor, meestal op papier opgetekende en verzonden correspondentie die een ietwat officiëler karakter draagt dan memo's of aantekeningen.",
                "@language": "nl"
              },
              {
                "@value": "Korrespondenzstück, das etwas förmlicher ist als eine \"Notiz\" oder eine \"Mitteilung\", in der Regel auf Papier und versandt.",
                "@language": "de"
              }
            ],
            "type": "Concept",
            "broader": "http://vocab.getty.edu/aat/300026877",
            "altLabel": [
              {
                "@value": "letter (correspondence)",
                "@language": "en"
              },
              {
                "@value": "brief",
                "@language": "nl"
              },
              {
                "@value": "Briefe",
                "@language": "de"
              },
              {
                "@value": "carta (correspondencia)",
                "@language": "es"
              }
            ],
            "prefLabel": [
              {
                "@value": "letters (correspondence)",
                "@language": "en"
              },
              {
                "@value": "brieven (correspondentie)",
                "@language": "nl"
              },
              {
                "@value": "lettre",
                "@language": "fr"
              },
              {
